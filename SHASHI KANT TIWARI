import math

def perplexity(self, sentence):
    """
    Calculate the perplexity of a given sentence.
    """
    sentence_tokens = word_tokenize(sentence.lower())
    sentence_ngrams = list(ngrams(sentence_tokens, 
                                  n=self.ngram_count, 
                                  pad_left=True, 
                                  pad_right=True, 
                                  left_pad_symbol='<start>', 
                                  right_pad_symbol='<end>'))
    
    log_prob_sum = 0
    N = len(sentence_ngrams)

    for ngram in sentence_ngrams:
        context = ngram[:-1]
        next_word = ngram[-1]
        
        probabilities = self.probability_distribution(ngram)
        
        if next_word in probabilities:
            log_prob_sum += math.log2(probabilities[next_word])
        else:
            log_prob_sum += math.log2(1e-10)  # Small smoothing value to avoid log(0)

    perplexity_value = 2 ** (-log_prob_sum / N)
    return perplexity_value

